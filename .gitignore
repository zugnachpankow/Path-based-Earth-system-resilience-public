# General Python-related files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints

# Ignore plots and figures
*.png
*.pdf
*.svg

# Ignore outputs and large files
*.nc
*.npy
*.pkl
*.csv
*.zip

# SLURM logs
*.err
*.out
/logs/
/tipping_probabilities/err_out/

# Pipeline intermediate outputs (regenerated; large data live under output/ locally or on Zenodo)
/output/
/data/processed/

# Other
*.db
*.swp
job_submit.sh          # transient, generated by 07_submit_tipping.py

# Internal working doc + one-off diagnostics (not part of the published pipeline)
ROADMAP.md
seam_check.py
export_results_for_writeup.py
check_sobol_rate.py
run_checkrate.sh

# ── Publication artefacts (tracked despite the blanket image/csv ignores) ──────────
!figures/
!figures/**
!tables/
!tables/**

# ── Input data ─────────────────────────────────────────────────────────────────────
# Ship ONLY the open FAIR calibration files (whitelisted individually). NGFS scenario
# data is LICENSED — it must NEVER be committed. RCMIP is downloaded by the user.
!data/raw/
!data/raw/calibrated_constrained_parameters_calibration1.4.1.csv
!data/raw/species_configs_properties_calibration1.4.1.csv
!data/raw/species_configs_properties_NGFS.csv
!data/raw/fair_units_reference.csv
!data/raw/fair_variables_reference.csv
!data/raw/volcanic_solar.csv
!data/reference/
!data/reference/**

# Hard excludes (belt-and-suspenders; already covered by the blanket *.csv rule)
data/raw/NGFS_cleaned_IAM_all.csv
data/raw/rcmip-*.csv
data/NGFS_raw/
